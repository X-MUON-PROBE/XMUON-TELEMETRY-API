{
  "openapi": "3.0.4",
  "info": {
    "title": "TELEMETRY_API",
    "version": "1.0"
  },
  "paths": {
    "/telemetry/missionInit/{missionName}": {
      "get": {
        "tags": [
          "TELEMETRYOPS_"
        ],
        "parameters": [
          {
            "name": "missionName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/telemetry/storeMeasurementRecord": {
      "post": {
        "tags": [
          "TELEMETRYOPS_"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/struct_measurementDataPacket"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/struct_measurementDataPacket"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/struct_measurementDataPacket"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/WeatherForecast": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "struct_accelerationVector": {
        "type": "object",
        "properties": {
          "ax": {
            "type": "number",
            "format": "float"
          },
          "ay": {
            "type": "number",
            "format": "float"
          },
          "az": {
            "type": "number",
            "format": "float"
          }
        },
        "additionalProperties": false
      },
      "struct_gyroscopeVector": {
        "type": "object",
        "properties": {
          "gx": {
            "type": "number",
            "format": "float"
          },
          "gy": {
            "type": "number",
            "format": "float"
          },
          "gz": {
            "type": "number",
            "format": "float"
          }
        },
        "additionalProperties": false
      },
      "struct_measurementDataPacket": {
        "type": "object",
        "properties": {
          "totalGeigerCounts": {
            "type": "integer",
            "format": "int32"
          },
          "geigerCountsPerMinute": {
            "type": "integer",
            "format": "int32"
          },
          "geigerDose": {
            "type": "number",
            "format": "float"
          },
          "temperature": {
            "type": "number",
            "format": "float"
          },
          "atmPressure": {
            "type": "number",
            "format": "float"
          },
          "altitude": {
            "type": "number",
            "format": "float"
          },
          "accelVector": {
            "$ref": "#/components/schemas/struct_accelerationVector"
          },
          "gyroVector": {
            "$ref": "#/components/schemas/struct_gyroscopeVector"
          },
          "gyroChipTemperature": {
            "type": "number",
            "format": "float"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "TELEMETRYOPS_"
    },
    {
      "name": "WeatherForecast"
    }
  ]
}